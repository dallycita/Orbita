{
  "name": "orbita",
  "private": true,
  "description": "Órbita: escapa del agujero negro saltando entre anillos, al ritmo de la música.",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "huella": "node pruebas/huella.mjs",
    "deps": "node build.mjs --deps",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"pruebas/**/*.mjs\" \"herramientas/**/*.mjs\" \"*.{mjs,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"pruebas/**/*.mjs\" \"herramientas/**/*.mjs\" \"*.{mjs,js,json,md}\"",
    "lint": "eslint src/js",
    "test": "node build.mjs --check",
    "audio": "node pruebas/audio.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-scope": "^8.4.0",
    "espree": "^10.4.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1"
  }
}
